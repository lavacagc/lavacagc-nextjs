# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Video files - hosted on Supabase Storage
public/videos/*.mp4

# Supabase temp files
supabase/.temp/

# Lavish artifact working dir (local review surfaces)
.lavish/
.playwright-mcp/

# Local preview renders and session scratch (never commit)
.preview/

# Local working files that live in the repo dir but never belong in git.
# (A gate run requires a clean tree; these are session scratch, owner notes,
# and local tooling config - commit any of them deliberately if that changes.)
# No `!/CLAUDE.md` negation here: macOS checkouts set core.ignorecase, so an
# uppercase negation also matches this lowercase pattern and, being later,
# cancels it - the scratch file came back into `git status` on the one platform
# this is written for. Project instructions belong to a tracked CLAUDE.md, and
# ignore rules never apply to a tracked file.
/claude.md
/legal/
/*.png
/*.jpeg
/*.jpg
/.githooks/
/.gitleaks.toml
/supabase/config.toml
/supabase/.gitignore
/scripts/crew-dispatch-live-test.ts
/scripts/crew-dispatch-preview.ts
/scripts/newsletter-samples.ts
/scripts/seo-live-check.ts
