{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "lavacagc.com"
        }
      ],
      "destination": "https://www.lavacagc.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/send-follow-ups",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/generate-renderings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/seo-ingest?days=3",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/seo-report?email=1",
      "schedule": "30 6 * * 1"
    },
    {
      "path": "/api/cron/seo-suggest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/seo-rollback",
      "schedule": "30 7 * * 1"
    },
    {
      "path": "/api/cron/home-care-newsletter",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/cron/resend-sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/seo-maintain",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/visit-reminders",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/visit-dispatch-escalation?stage=nudge",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/visit-dispatch-escalation?stage=escalate",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/intake-chase?stage=low_intent",
      "schedule": "0 13,16,19,22 * * *"
    },
    {
      "path": "/api/cron/intake-chase?stage=abandoned",
      "schedule": "0 13,16,19,22 * * *"
    }
  ]
}
