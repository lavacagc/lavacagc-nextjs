# Local correctness gate: the Mac is the gatekeeper, so CI minutes are not.
# Four checks, cheapest first; the first failure blocks the push:
#   1. TypeScript type check   (tsc --noEmit, whole project)     ~seconds
#   2. ESLint                  (only the files this push changes) ~seconds
#   3. Production build        (next build via scripts/test-build.sh - the
#                               same one-definition build CI's e2e job uses;
#                               stub env, so it never dials hosted Supabase)
#   4. Playwright smoke        (critical-path specs only, against the build
#                               from step 3 - see `npm run test:smoke`)
# A docs-only push (docs/, root Markdown, .lavish/, .claude/) skips all of
# them - see the rule above the ref loop below.
#
# Emergency bypass: `git push --no-verify`. Use it knowingly: the trimmed CI
# no longer repeats the expensive checks, so whatever you skip stays unchecked.
#
# Bare tool names on purpose: the husky runner (.husky/_/h) prepends
# node_modules/.bin to PATH, so these resolve to the pinned binaries and a
# missing install fails loudly as exit 127. See .no-mistakes.yaml for the
# npm-run/never-npx rule this follows.

set -u

fail() {
  echo ""
  echo "pre-push: PUSH BLOCKED - $1" >&2
  echo "pre-push: fix the problem and push again (or 'git push --no-verify' in a real emergency)." >&2
  exit 1
}

# --- work out which files this push actually changes ------------------------
# git feeds pre-push lines on stdin: <local ref> <local sha> <remote ref> <remote sha>
ZERO="0000000000000000000000000000000000000000"
LINT_LIST=$(mktemp)
trap 'rm -f "$LINT_LIST" "$LINT_LIST.sorted"' EXIT

# Docs-only pushes (docs/, Markdown, review pages, agent config) change nothing the
# checks below can see, so they are skipped. The same rule the Vercel ignore
# step uses (scripts/vercel-ignore-build.sh). Added 2026-10-29 after the weekly
# article routine's social-copy push ran the full smoke in a cloud sandbox with no
# browser installed and had to be redone. Decided per pushed ref, from the same
# base the lint list uses: every ref must be docs-only, and a ref with no usable
# base is never treated as docs-only.

PUSHING_CODE=0
ALL_DOCS_ONLY=1
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch pushes no code - nothing to check for this ref.
  [ "$local_sha" = "$ZERO" ] && continue
  PUSHING_CODE=1
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    # New branch on the remote (or a remote sha we do not have): compare
    # against where this branch forked from main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null) || base=""
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- . ':(exclude)docs' ':(exclude,glob)*.md' ':(exclude).lavish' ':(exclude).claude'; then
    ALL_DOCS_ONLY=0
  fi
  if [ -n "$base" ]; then
    git diff --name-only --diff-filter=d "$base" "$local_sha" -- '*.ts' '*.tsx' '*.js' '*.jsx' >>"$LINT_LIST"
  else
    # No usable base at all (fresh repo edge case): lint every tracked source file.
    git ls-files -- '*.ts' '*.tsx' '*.js' '*.jsx' >>"$LINT_LIST"
  fi
done

# Only branch deletions in this push: let it through untouched.
[ "$PUSHING_CODE" = "1" ] || exit 0

if [ "$ALL_DOCS_ONLY" = "1" ]; then
  echo "pre-push: docs-only push (docs/, Markdown, .lavish/, .claude/), skipping typecheck, chaos static, lint, build and smoke."
  exit 0
fi

# --- pre-flight: port 3000 must be free -------------------------------------
# Step 4's Playwright config reuses any server already listening on :3000, and
# a leftover `npm run dev` there serves the WRONG baked env (see CLAUDE.md).
# Fail in one second instead of after a multi-minute build.
if lsof -ti :3000 -sTCP:LISTEN >/dev/null 2>&1; then
  fail "something is already listening on port 3000 (a dev server?). Stop it first - the smoke tests would silently test the wrong server."
fi

# --- 1/4 TypeScript ---------------------------------------------------------
echo "pre-push [1/5] TypeScript type check (tsc --noEmit)..."
# tsc reads .next/types/, which only `next build` writes - and a FAILED build
# leaves stale files there referencing routes that no longer exist, breaking
# tsc with a phantom error. Reset to exactly what CI stubs before its
# typecheck: an empty routes.d.ts and nothing else.
rm -rf .next/types
mkdir -p .next/types
touch .next/types/routes.d.ts
npm run typecheck || fail "TypeScript found type errors (step 1/5)."

# --- 2/5 Chaos static checks ------------------------------------------------
# Structural invariants distilled from the chaos-monkey run (chaos/findings.json):
# uncapped reads of growing tables, guards that fail open when their own secret
# is missing, analytics mounted on token-authenticated pages, duplicated owner
# alerts, and public routes that can send outbound with nothing in front of them.
#
# RATCHET, not a wall. Known violations are recorded in chaos/static-baseline.json
# and do not block; only NEW ones do. That baseline is a debt register - shrink it
# with `npm run chaos:static:baseline` as findings close, never grow it silently.
# Costs about a second, which is why it lives here rather than in CI.
echo "pre-push [2/5] Chaos static checks (new-violation ratchet)..."
npm run chaos:static || fail "a NEW structural violation was introduced (step 2/5). See the list above; chaos/findings.json explains each class."

# --- 3/5 ESLint on the pushed files only ------------------------------------
sort -u "$LINT_LIST" >"$LINT_LIST.sorted"
# A file can be renamed/deleted after the pushed commit on an unusual push;
# lint only paths that exist in the working tree.
: >"$LINT_LIST"
while read -r f; do
  [ -f "$f" ] && printf '%s\n' "$f" >>"$LINT_LIST"
done <"$LINT_LIST.sorted"

if [ -s "$LINT_LIST" ]; then
  echo "pre-push [3/5] ESLint on $(wc -l <"$LINT_LIST" | tr -d ' ') changed file(s)..."
  tr '\n' '\0' <"$LINT_LIST" | xargs -0 eslint --max-warnings 0 || fail "ESLint found problems in the files you are pushing (step 3/5)."
else
  echo "pre-push [3/5] ESLint: no JS/TS files changed in this push - skipped."
fi

# --- 4/5 Production build ---------------------------------------------------
echo "pre-push [4/5] Production build (next build, stub env - a few minutes)..."
npm run test:build || fail "the production build failed (step 4/5)."

# --- 5/5 Playwright smoke ---------------------------------------------------
echo "pre-push [5/5] Playwright smoke tests (critical path)..."
npm run test:smoke || fail "smoke tests failed (step 5/5). Report: npm run test:report"

echo ""
echo "pre-push: all 5 checks passed - pushing."
