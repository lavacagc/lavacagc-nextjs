#!/usr/bin/env sh
# Alex's standing rule: no agent or model is ever a co-author of a commit.
# Rejects any commit whose message carries a Co-Authored-By trailer, whichever
# tool wrote it (Claude Code, the no-mistakes gate, a builder agent).
if grep -qi '^Co-Authored-By:' "$1"; then
  echo "commit-msg: Co-Authored-By trailers are not allowed in this repository; remove the line and commit again." >&2
  exit 1
fi
